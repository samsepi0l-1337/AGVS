    {
      "slug": "vehicle-controller",
      "name": "Vehicle Controller",
      "category": "technology",
      "model": "",
      "specs": [],
      "images": [
        {
          "src": "img/products/controller/01.jpg",
          "text": "The PDM360 is designed for the control of Automatic Guided Vehicles (AGV) and features reliable 24/7 operation, ease of integration, and flexibility to handle a multiplicity of vehicle types and navigation methods. The controller is the heart of the vehicle. The software functions supervise everything from navigation of the vehicle to communication with the AGV system controller and load operations. When operating, the vehicle is in continuous contact with the AGV system controller, receiving and transmitting information such as work orders and traffic information. The vehicle is equipped with components for navigation and sensors of varying types for load handling. Communication between the PDM360 and the equipment is via CAN bus or Ethernet communication."
        }
      ],
      "source": "https://www.agvsk.com/bbs/content.php?co_id=controller"
