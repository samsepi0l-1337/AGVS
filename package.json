{
	"private": true,
	"devDependencies": {
		"@prettier/plugin-php": "^0.22.4",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"prettier": "^3.9.6"
	},
	"scripts": {
		"build": "pnpm run build:static && pnpm run format",
		"build:static": "bash scripts/build-static.sh",
		"format": "prettier --write \"**/*.{js,css,html,json,md,php,yml,yaml}\" \"_site/**/*.{js,css,html,json}\"",
		"format:check": "prettier --check \"**/*.{js,css,html,json,md,php,yml,yaml}\" \"_site/**/*.{js,css,html,json}\""
	},
	"packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
