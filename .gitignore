node_modules/
storage/backups/
storage/trash/

# storage/uploads/ is TRACKED on purpose. render.ts copies it into the built
# site, so an attachment only reaches GitHub Pages if it is committed — CI
# checks out the repo and nothing else. While it was ignored, every archive
# download link 404'd in production.
#
# The consequence, stated so it is not a surprise: an upload made through the
# admin UI does not appear on the live site until someone commits the file.
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
dist/
.env
.env.local

# macOS Finder duplicate / conflict copies ("foo 2.php", empty "bar 2" dirs)
* 2.*
* 2

# macOS Finder metadata. Untracked but not ignored until now, so a stray
# `git add` would have committed it and the build copies src/assets wholesale —
# which would have published .DS_Store to the live site.
.DS_Store

# Track lockfile even if ignored by a global gitignore
!pnpm-lock.yaml

docs/superpowers/*