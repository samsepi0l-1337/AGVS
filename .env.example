# Bcrypt hash for the admin password (PHP password_hash / $2y$ compatible).
# Generate: php -r "echo password_hash('your-password', PASSWORD_BCRYPT, ['cost'=>12]), PHP_EOL;"
# Do not put the plaintext password in this file or in source.
AGVS_ADMIN_PASSWORD_HASH=

# HMAC secret for the admin session cookie (use a long random string).
AGVS_ADMIN_SESSION_SECRET=

# Path to the SQLite content database (relative to repo root or absolute).
AGVS_SQLITE_PATH=data/agvs.sqlite

# Admin API listen port (default 8850).
AGVS_ADMIN_API_PORT=8850
