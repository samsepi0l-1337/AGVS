{
	"extends": "./base.json",
	"compilerOptions": {
		"target": "esnext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["esnext"],
		"outDir": "../dist/api",
		"rootDir": "../src/api",
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": false,
		"composite": true,
		"tsBuildInfoFile": "../dist/api/tsconfig.api.tsbuildinfo"
	},
	"include": ["../src/api/**/*.ts"],
	"exclude": ["../dist", "../node_modules"]
}
