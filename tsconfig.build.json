{
	"compilerOptions": {
		"rootDir": "src/build",
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022"],
		"types": ["node"],
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedIndexedAccess": false,
		"noEmit": true
	},
	"include": ["src/build/**/*.ts"]
}
